# URL của EShop Backend (mặc định khi chạy local: http://localhost:3000)
# Khi deploy lên Vercel, đặt giá trị này thành URL public của backend (Render)
VITE_API_URL=http://localhost:3000

# API Key của Maze Universal Snippet (lấy trong Maze -> Project Settings -> Install Snippet)
VITE_MAZE_API_KEY=YOUR_MAZE_API_KEY
